#!/usr/bin/env bash
# Set the WezTerm tab title to a tmux session / project name.
# Usage: wezterm-set-tab-title [title] [client_tty]

title="${1:-}"
client_tty="${2:-}"

if [[ -z "$title" ]]; then
    title="$(tmux display-message -p '#S' 2>/dev/null || true)"
fi

[[ -z "$title" ]] && exit 0
command -v wezterm >/dev/null 2>&1 || exit 0

# Strip sessionizer suffix so the tab shows the project name
title="${title%"-tmux-sessionizer"}"

pane_id="${WEZTERM_PANE:-}"

if [[ -z "$pane_id" && -n "$client_tty" ]] && command -v jq >/dev/null 2>&1; then
    pane_id="$(
        wezterm cli list --format json 2>/dev/null |
            jq -r --arg tty "$client_tty" \
                '.[] | select(.tty_name == $tty) | .pane_id' |
            head -n 1
    )"
fi

if [[ -n "$pane_id" ]]; then
    wezterm cli set-tab-title --pane-id "$pane_id" "$title" >/dev/null 2>&1 || true
else
    wezterm cli set-tab-title "$title" >/dev/null 2>&1 || true
fi
